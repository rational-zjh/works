    },
    {
      "id": "8b278954",
      "cell_type": "markdown",
      "source": [
        "以下是含有一个RNN层的递归神经网络主要层的导出。"
      ],
      "attachments": {},
      "metadata": {
        "name": "章节名称",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "debe7140",
      "cell_type": "code",
      "source": [
        "using Flux\nusing ONNXNaiveNASflux\n\n# 该模型接收5个变量，通过RNN进行处理并输出2个值\nrnn_model = Chain(\n    RNN(5 => 10),      # 输入：5个特征，隐藏层：10个特征\n    Dense(10 => 2)     # 输出层将隐藏层状态转换为两个类别/值\n)\n\n# 定义输入张量的维度：\n# 变量数 = 5，批次大小 = 1，输入序列长度 = 100\ninput_shape = (5, 1, 100)\n\nONNXNaiveNASflux.save(\"rnn_model.onnx\", rnn_model, input_shape);"
      ],
      "execution_count": 0,
      "outputs": [],
      "metadata": {
        "name": "章节名称",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false,
          "outputInfo": {
            "isExpanded": false,
            "scrollTop": 0
          },
          "maskInfo": {
            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "25d46ad8",
      "cell_type": "markdown",
      "source": [
        "从ONNX文件运行递归网络："
      ],
      "attachments": {},
      "metadata": {
        "name": "章节名称",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "abbaa9cf",
      "cell_type": "code",
      "source": [
        "import ONNXRunTime as ORT\nonnx_rnn_model = ORT.load_inference(\"rnn_model.onnx\")\nonnx_rnn_model"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": "InferenceSession\n    input_names:        [\"data_0\"]\n    output_names:       [\"dense_0\"]\n    execution_provider: :cpu\n"
          },
          "metadata": {},
          "execution_count": 53
        }
      ],
      "metadata": {
        "name": "章节名称",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false,
          "outputInfo": {
            "isExpanded": false,
            "scrollTop": 0
