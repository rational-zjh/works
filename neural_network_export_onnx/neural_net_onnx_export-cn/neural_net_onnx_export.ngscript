          "maskInfo": {
            "isMaskVisible": true,
            "isEditorVisible": true,
            "isAutoplayActive": false
          }
        }
      }
    },
    {
      "id": "6732351b",
      "cell_type": "markdown",
      "source": [
        "有了这些信息，我们可以运行递归神经网络并预测输入时间序列每个采样点的输出特征："
      ],
      "attachments": {},
      "metadata": {
        "name": "章节名称",
        "engee": {
          "isDisplay": true,
          "isParagraph": false,
          "isClosedParagraph": false,
          "amountHideCellsInside": 0,
          "codeOutputView": "col",
          "codeOutputHidden": false
        }
      }
    },
    {
      "id": "d2b59768",
      "cell_type": "code",
      "source": [
        "plot()\nfor x in 1:20\n     # 生成测试序列：5个特征，100个时间步\n     raw_data = rand(Float32, 5, 100)\n\n     # 添加批次维度（ONNX标准）\n     input_tensor = reshape(raw_data', 100, 1, 5) \n     outputs = onnx_rnn_model(Dict(\"data_0\" => input_tensor))\n     onnx_output = outputs[\"dense_0\"]\n\n     # 将数据重组为矩阵（100行，2列）\n     plot_data = reshape(onnx_output, 100, 2)\n\n     gr()\n     plot!(plot_data, title=\"20次随机运行的RNN预测\",\n         label = (x==1 ? [\"输出1\" \"输出2\"] : false),\n         line = (x==1 ? (5,:solid) : (1,:dot)),\n         c = [:red :black],\n         xlabel=\"时间步（采样点）\")\nend\nplot!()"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "image/png": "",
            "text/html": "<img src=\"data:image/png;base64,\" />",
